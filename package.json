{
  "name": "moreover-reader",
  "displayName": "Moreover Reader",
  "description": "在 VS Code 终端里伪装成 AI 编码会话摸鱼读小说。d 切换显示、失焦自动隐藏、i 看插图、e 看注解、a 自动滚动。支持 EPUB/TXT。",
  "version": "1.3.7",
  "publisher": "wisonic",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Other"],
  "keywords": ["read", "novel", "book", "摸鱼", "阅读", "epub", "txt", "terminal"],
  "activationEvents": ["onStartupFinished"],
  "main": "./extension.js",
  "configuration": {
    "title": "Moreover Reader",
    "properties": {
      "moreoverReader.lines": {
        "type": "number",
        "default": 3,
        "minimum": 1,
        "maximum": 50,
        "description": "终端里同时显示的小说正文行数（默认 3，越小越隐蔽）"
      },
      "moreoverReader.columns": {
        "type": "number",
        "default": 82,
        "minimum": 40,
        "maximum": 200,
        "description": "正文每行折行的终端列宽（中文按 2 列计，默认 82）"
      }
    }
  },
  "contributes": {
    "commands": [
      { "command": "moreoverReader.openBook", "title": "Moreover: Open Book (打开图书)" },
      { "command": "moreoverReader.removeBook", "title": "Moreover: Remove Book (移除图书)" },
      {
        "command": "moreoverReader.openPath",
        "title": "Moreover: Open from Shelf (从书架打开)"
      },
      {
        "command": "moreoverReader.removeShelfItem",
        "title": "Moreover: Remove from Shelf (移除)"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "moreoverReader.removeShelfItem",
          "when": "view == moreoverReader.shelf && viewItem == moreoverBook"
        }
      ],
      "view/title": [
        {
          "command": "moreoverReader.openBook",
          "group": "navigation",
          "when": "view == moreoverReader.shelf"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moreover-reader",
          "title": "Moreover Reader",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "moreover-reader": [
        { "id": "moreoverReader.shelf", "name": "书架" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "moreoverReader.shelf",
        "contents": "书架还是空的。\n[打开图书…](command:moreoverReader.openBook)"
      }
    ]
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
